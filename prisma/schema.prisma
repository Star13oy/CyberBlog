generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model categories {
  id          String   @id
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  posts       posts[]

  @@index([slug])
}

model comments {
  id             String     @id
  content        String
  postId         String
  authorId       String
  parentId       String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime
  users          users      @relation(fields: [authorId], references: [id])
  comments       comments?  @relation("commentsTocomments", fields: [parentId], references: [id], onDelete: Cascade)
  other_comments comments[] @relation("commentsTocomments")
  posts          posts      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([parentId])
  @@index([postId])
}

model daily_logs {
  id          String   @id
  date        DateTime @db.Date
  title       String?
  content     String
  aiGenerated Boolean  @default(false)
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  users       users    @relation(fields: [authorId], references: [id])
  tasks       tasks[]

  @@unique([date, authorId])
  @@index([authorId])
  @@index([date])
}

model posts {
  id           String       @id
  title        String       @db.VarChar(200)
  slug         String       @unique
  content      String
  excerpt      String?      @db.VarChar(500)
  coverImage   String?
  categoryId   String?
  viewCount    Int          @default(0)
  likeCount    Int          @default(0)
  commentCount Int          @default(0)
  status       posts_status @default(DRAFT)
  isFeatured   Boolean      @default(false)
  publishedAt  DateTime?
  aiGenerated  Boolean      @default(false)
  aiSummary    String?
  authorId     String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime
  comments     comments[]
  users        users        @relation(fields: [authorId], references: [id])
  categories   categories?  @relation(fields: [categoryId], references: [id])
  tags         tags[]       @relation("posttotag")

  @@index([authorId])
  @@index([categoryId])
  @@index([publishedAt])
  @@index([slug])
  @@index([status])
}

model settings {
  id          String   @id
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([key])
}

model statistics {
  id          String   @id
  date        DateTime @unique @db.Date
  postCount   Int      @default(0)
  viewCount   Int      @default(0)
  taskTotal   Int      @default(0)
  taskDone    Int      @default(0)
  commitCount Int      @default(0)
  codeLines   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([date])
}

model tags {
  id        String   @id
  name      String   @unique
  slug      String   @unique
  color     String?
  createdAt DateTime @default(now())
  posts     posts[]  @relation("posttotag")

  @@index([slug])
}

model tasks {
  id          String       @id
  title       String
  description String?
  status      tasks_status @default(TODO)
  progress    Int          @default(0)
  dailyLogId  String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime
  daily_logs  daily_logs   @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)

  @@index([dailyLogId])
  @@index([status])
}

model users {
  id         String       @id
  email      String       @unique
  username   String       @unique
  password   String
  name       String?
  avatar     String?
  role       users_role   @default(USER)
  status     users_status @default(ACTIVE)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime
  comments   comments[]
  daily_logs daily_logs[]
  posts      posts[]

  @@index([email])
  @@index([username])
}

enum tasks_status {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum users_role {
  USER
  ADMIN
  AI_AGENT
}

enum users_status {
  ACTIVE
  INACTIVE
  BANNED
}

enum posts_status {
  DRAFT
  PUBLISHED
  ARCHIVED
}
